flowchart LR
    classDef actor fill:#f7f7f7,stroke:#4a5568,stroke-width:1px;
    classDef app fill:#e6fffa,stroke:#2c7a7b,stroke-width:1.4px;
    classDef data fill:#ebf8ff,stroke:#2b6cb0,stroke-width:1.2px;
    classDef ext fill:#fff5f5,stroke:#c53030,stroke-width:1.2px;

    Donor([Donor]):::actor
    Volunteer([Volunteer]):::actor
    Admin([Admin]):::actor
    Creator([Campaign Creator]):::actor

    subgraph FE[Frontend Container]
      Web[React + TypeScript SPA]:::app
    end

    subgraph BE[Backend Container]
      API[ASP.NET Core Web API]:::app
      ML[ML Prediction Service]:::app
      Notify[Notification Service]:::app
    end

    DB[(SQL Server)]:::data
    Payment[[SSLCommerz Gateway]]:::ext
    MailSms[[Email and SMS Providers]]:::ext

    Donor --> Web
    Volunteer --> Web
    Creator --> Web
    Admin --> Web

    Web --> API
    API --> DB
    API --> Payment
    API --> Notify
    Notify --> MailSms
    API --> ML
