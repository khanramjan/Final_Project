    classDef infra fill:#fffaf0,stroke:#c05621,stroke-width:1px;
    classDef data fill:#ebf8ff,stroke:#2b6cb0,stroke-width:1.1px;

    subgraph API[DonationManagementSystem.API]
      AuthController[AuthController]:::comp
      CampaignController[CampaignController]:::comp
      DonationController[DonationController]:::comp
      PaymentController[PaymentController]:::comp
      VolunteerController[VolunteerController]:::comp
      TestimonialController[TestimonialController]:::comp
      AnalyticsController[AnalyticsController]:::comp
      MLController[MLController]:::comp

      JwtService[JwtService]:::comp
      PaymentService[PaymentService]:::comp
      EmailService[EmailService]:::comp
      SmsService[SmsService]:::comp
      MLPredictionService[MLPredictionService]:::comp
      VolunteerRankingService[VolunteerRankingService]:::comp

      AppDbContext[AppDbContext]:::data
